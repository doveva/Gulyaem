# PostgreSQL/PostGIS
POSTGRES_DB=gulyaem
POSTGRES_USER=gulyaem
POSTGRES_PASSWORD=gulyaem
POSTGRES_PORT=5532

# Backend
API_PORT=8080
ENVIRONMENT=development
ASKCEL_RUNTIME_CONTRACT_VERSION=1
ASKCEL_PRODUCT=walking
ASKCEL_WORKLOAD=walking-api
ASKCEL_ENVIRONMENT=development
ASKCEL_RELEASE=local
ASKCEL_VERSION=dev
# ASKCEL_INSTANCE and ASKCEL_BUILD_COMMIT are optional deployment provenance.
ASKCEL_INSTANCE=
ASKCEL_BUILD_COMMIT=
# Optional OpenTelemetry collector, for example http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
LOG_LEVEL=info
GEO_TEST_AREA=spb-stage1-validation
NORMALIZATION_VERSION=stage1-segments-v1
MAX_SEGMENT_LENGTH_M=0
DISTRICT_TEST_AREA=spb-administrative-districts
DISTRICT_NORMALIZATION_VERSION=stage1-districts-v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (embedded at image build time)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VALHALLA_PORT=8002
GRAPHHOPPER_PORT=8989
OSRM_PORT=5001
VITE_CITY_ID=01900000-0000-7000-8000-000000000001
