{
  "code_extensions": [
    ".go",
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".py",
    ".sql",
    ".graphql",
    ".proto",
    ".yaml",
    ".yml",
    ".sh",
    ".css",
    ".scss"
  ],
  "code_filenames": [
    "Dockerfile",
    "Makefile"
  ],
  "exclude_patterns": [
    "**/*_test.go",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**"
  ]
}
